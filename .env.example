# Solo se necesita para ejecutar una corrida nueva con Claude.
OPENROUTER_API_KEY=reemplaza_con_tu_clave
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# LangSmith es opcional. Déjalo en false para ejecutar solo de forma local.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=reemplaza_con_tu_clave
LANGSMITH_PROJECT=S5-HillClimbing-Reactivacion

# Configura LANGSMITH_ENDPOINT únicamente si tu cuenta usa una región distinta.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
